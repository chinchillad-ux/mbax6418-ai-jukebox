# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Secrets — never commit. Real endpoints/keys live outside the repo
# (e.g. ~/class-endpoints/). Only the dummy template is tracked.
.env
.env.*
!.env.example

# App data — generated at runtime: session audio, uploads, voice references.
# NEVER commit these. The only committed media is under assets/samples/.
data/

# Test / tooling artifacts
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# macOS
.DS_Store
