# MBAX 6418 class-service configuration — copy this file to `.env` and fill in
# the API key. The key is the SAME for all class services. NEVER commit `.env`
# and never paste the key into logs, screenshots, errors, or docs.
#
# Base URLs follow the supplied class-endpoints.txt handout (2026/09/30).
# Ports 9006-9008 are new for this assignment: confirm the exact URL shape
# (/v1 suffix and request format) from the handout before coding issues #2-#4.

API_KEY=replace-with-your-key
LLM_URL=http://dobolyi.com:9001/v1
COVER_ART_URL=http://dobolyi.com:9006
MUSIC_URL=http://dobolyi.com:9007
SPEECH_URL=http://dobolyi.com:9008

# Set the exact served model identifiers from the class service documentation.
# These placeholders are configuration examples, not verified request IDs.
LLM_MODEL=replace-with-served-qwen-model-id
COVER_ART_MODEL=replace-with-served-flux-model-id
MUSIC_MODEL=replace-with-served-ace-step-model-id
SPEECH_MODEL=replace-with-served-chatterbox-model-id
